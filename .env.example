NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Paste the service account JSON on one line, or set the three fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=
OPENROUTER_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL=
STRIPE_PRICE_INDIVIDUAL_YEARLY=
STRIPE_PRICE_ORGANIZER=
# Team quantity subscription. Never reuse STRIPE_PRICE_ORGANIZER.
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Vercel sends this as Authorization: Bearer … on the daily digest cron.
CRON_SECRET=
# Optional. Cron uses the request host if this is empty.
APP_ORIGIN=https://billoai.com
NEXT_PUBLIC_APP_ORIGIN=https://billoai.com

# Azure Blob Storage for profile pictures on the public card. Not used for card photos.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=profile-photos
# Prefer a service principal (DefaultAzureCredential). Connection string is local/dev fallback.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_CONNECTION_STRING=

# Optional extra operator emails for /admin, comma-separated. Support inbox is always included.
ADMIN_EMAILS=
